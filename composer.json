{
    "name": "beziworld/laravel-polish-validation",
    "description": "Laravel validation rules for Polish identifiers: PESEL, NIP, REGON, KRS, IBAN/NRB, ID card, postal code and phone numbers.",
    "keywords": [
        "laravel",
        "validation",
        "pesel",
        "nip",
        "regon",
        "iban",
        "poland",
        "polish"
    ],
    "homepage": "https://github.com/beziworld/laravel-polish-validation",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Kamil Ćwiertnia",
            "email": "biuro@beziworld.eu",
            "homepage": "https://beziworld.eu",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/beziworld/laravel-polish-validation/issues",
        "source": "https://github.com/beziworld/laravel-polish-validation"
    },
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/translation": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpstan/phpstan-strict-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Beziworld\\PolishValidation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Beziworld\\PolishValidation\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test-coverage": "pest --coverage --min=80",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "lint": "pint --test",
        "ci": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Beziworld\\PolishValidation\\PolishValidationServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
